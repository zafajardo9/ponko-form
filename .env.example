# Neon PostgreSQL (get from console.neon.tech)
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth email and password authentication
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional canonical base URL for server jobs that run without an HTTP request.
# Set this to the production workers.dev or custom-domain URL on Cloudflare.
# On Render, RENDER_EXTERNAL_URL is the automatic fallback.
APP_URL=

# Encryption key for user-supplied credentials stored in the DB (payment/SMTP).
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates all stored credentials (users must re-enter them).
CREDENTIALS_ENCRYPTION_KEY=

# PayPal — OPTIONAL platform-wide fallback. Each user can set their own keys in
# Settings; these env vars are only used when a form owner hasn't configured one.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=

# Xendit — OPTIONAL platform-wide fallback (per-user keys live in Settings).
XENDIT_SECRET_KEY=

# Resend — SYSTEM email (the platform's own messages: password resets, account
# notices). This is separate from the per-user Resend integration in Settings
# and is never used as a fallback for form owner email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Protects the pending-payment reconciliation endpoint. A Render Cron Job may
# call it periodically with this value as a Bearer token.
CRON_SECRET=

# Anthropic (optional, for AI features)
ANTHROPIC_API_KEY=

# Builder AI — keep these credentials server-only.
# Gemini answers AI Guide questions; DeepSeek generates form drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
