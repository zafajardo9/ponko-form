{
  "name": "ponkoform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:cloudflare": "vite dev --mode cloudflare --port 3000",
    "build": "vite build",
    "build:cloudflare": "vite build --mode cloudflare",
    "build:render": "pnpm run build && pnpm run db:prepare",
    "build:deploy": "pnpm run db:prepare && pnpm run build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "vite preview --mode cloudflare",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-schema.ts",
    "db:prepare": "tsx scripts/prepare-database.ts && pnpm run db:check && pnpm run db:seed-form-templates",
    "payments:reconcile": "tsx scripts/reconcile-payments.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed-flow": "tsx scripts/seed-flow.ts",
    "db:seed-service-flow": "tsx scripts/seed-service-flow.ts",
    "db:seed-form-templates": "tsx scripts/seed-form-templates.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "@tanstack/router-plugin": "1.168.19",
    "@xyflow/react": "^12.11.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "liquid-gooey": "^0.1.0",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^9.0.3",
    "ogl": "^1.0.11",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.16.1",
    "srvx": "^0.12.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.180.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "react-grab": "^0.1.48",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.115.0"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/router-generator": "1.167.18",
      "@tanstack/router-plugin": "1.168.19"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
