.env
.env.local
*.local
.DS_Store

# Plans & analysis (not needed for the deployment).
# NOTE: do not ignore `docs` — both `src/components/docs` (imported by app code)
# and the root `docs/*.md` (bundled at build time via import.meta.glob) are required.
feature-plan
plans
memory-ponko
tmp
output

# IDE
.vscode
.idea

# CI / other platforms (not Vercel)
render.yaml

# Scripts used only for local DB management
scripts
drizzle

# Agent configurations
.agents
.claude
.hermes

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
